# ═══════════════════════════════════════════════════════════════════════════════
# Clarity AI — Backend Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Environment ──────────────────────────────────────────────────────────────
# Options: development | staging | production
ENV=development

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8000

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://localhost:8081

# ─── ChromaDB ────────────────────────────────────────────────────────────────
# Persistence directory (relative to backend/)
CHROMA_PERSIST_DIR=./chroma_db

# ─── Ollama (local LLM) ──────────────────────────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# ─── Embedding Model ──────────────────────────────────────────────────────────
# Sentence-transformers model name (downloaded from HuggingFace)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── Logging ──────────────────────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ─── Supabase (authentication & database) ──────────────────────────────────────
# Get these from your Supabase project dashboard -> Settings -> API
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── AI Providers ──────────────────────────────────────────────────────────────
# Provider-agnostic AI layer with automatic fallback.
# Free-first fallback: Gemini Free → DeepSeek → Qwen (Local) → Gemini Paid → OpenRouter → OpenAI → Claude
#
# At minimum, configure ONE of the following API keys.
# The system will auto-detect which providers are available.

# 1. Gemini (both free Flash & paid Pro use the same key)
#    Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AQ.Ab8RN6IP81UZXs_PfvRGnxqf6b0n9hppsnTYY0Vl2mJsUVVzKA
GEMINI_FREE_MODEL=gemini-2.0-flash
GEMINI_PAID_MODEL=gemini-2.5-pro-preview-06-05
GEMINI_MAX_TOKENS=1024

# 2. DeepSeek (very affordable, ~$0.14/M tokens)
#    Get key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-553c93ba487e4c288de914aed39dca9b
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=1024

# 3. Qwen via Ollama (free, local)
#    Requires Ollama running: https://ollama.ai
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b
# QWEN_MAX_TOKENS=1024

# 4. OpenRouter (free models available)
#    Get key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=mistralai/mistral-7b-instruct
# OPENROUTER_MAX_TOKENS=1024

# 5. OpenAI (paid, reliable fallback)
#    Get key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_TOKENS=1024

# 6. Anthropic Claude (paid, high quality)
#    Get key: https://console.anthropic.com/
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_MAX_TOKENS=1024

# ─── Global AI Settings ───────────────────────────────────────────────────────
# These apply to all providers unless overridden per-provider
# AI_TEMPERATURE=0.7
# AI_TIMEOUT=60

# ─── Frontend URL (for provider dashboard CORS) ────────────────────────────────
SITE_URL=http://localhost:5173

# ─── Security (production) ────────────────────────────────────────────────────
# Uncomment and set for production:
# SECRET_KEY=your-super-secret-key-here
# ADMIN_API_KEY=your-admin-api-key-here
# ALLOWED_ORIGINS=https://claritymode.com,https://www.claritymode.com
