# ═══════════════════════════════════════════════════════════════════════════════
# Clarity AI — Railway Production Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# Copy the values below into your Railway project's environment variables.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────────────────────────
ENV=production
PORT=8000

# Comma-separated frontend domains allowed for CORS
ALLOWED_ORIGINS=https://claritymode.vercel.app,https://claritymode.com

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── AI Providers (configure at least ONE) ────────────────────────────────────
# 1. Google Gemini (RECOMMENDED — free tier available)
#    Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. DeepSeek (very affordable)
# DEEPSEEK_API_KEY=

# 3. OpenRouter (free models)
# OPENROUTER_API_KEY=

# 4. OpenAI (paid)
# OPENAI_API_KEY=

# 5. Anthropic Claude (paid)
# ANTHROPIC_API_KEY=

# ─── Supabase (REQUIRED for auth & database) ───────────────────────────────────
#    Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required for admin operations (profile updates, etc.)
SUPABASE_SERVICE_ROLE_KEY=

# ─── ChromaDB (Vector Store Persistence) ──────────────────────────────────────
# Railway Volumes: Create a volume named "chroma-data" mounted at /data
# This ensures embeddings persist across deployments
CHROMA_PERSIST_DIR=/data/chroma_db
UPLOADS_DIR=/data/uploads

# ─── Embedding Model ──────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── Site URL (for provider dashboard, CORS) ──────────────────────────────────
SITE_URL=https://claritymode.vercel.app