# ═══════════════════════════════════════════════════════════════════════════════
# Clarity Mode — Frontend Production Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# This file documents the production environment variables for Vercel.
# Copy this to your Vercel project settings: https://vercel.com/dashboard
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Required: Backend API URL ────────────────────────────────────────────────
# The FULL URL of your Railway-deployed backend, NO trailing slash.
VITE_API_URL=https://clarity-mode-app-v2-production.up.railway.app

# ─── Required: Supabase ───────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Required: Public site URL ───────────────────────────────────────────────
# The URL where the frontend is deployed (no trailing slash)
# Used for auth redirects (OAuth callbacks, password reset emails, etc.)
VITE_SITE_URL=https://claritymode.vercel.app