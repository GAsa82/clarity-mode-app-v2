{
  "rewrites": [
    { "source": "/api/keep-alive",       "destination": "/api/keep-alive" },
    { "source": "/api/stripe/(.*)",      "destination": "/api/stripe/$1" },
    { "source": "/api/razorpay/(.*)",    "destination": "/api/razorpay/$1" },
    {
      "source": "/api/(.*)",
      "destination": "https://clarity-mode-app-v2-production-1982.up.railway.app/api/$1"
    },
    {
      "source": "/((?!api/|assets/|favicon|robots|bg-cover|placeholder).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|svg|png|jpg|jpeg|gif|webp|woff|woff2|ico)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "X-Frame-Options",         "value": "DENY" },
        { "key": "Referrer-Policy",         "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security","value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ]
}
