# WhatsApp Cloud API server settings
WHATSAPP_PHONE_ID=your_whatsapp_phone_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_RECIPIENTS=+15551234567,+15557654321
WHATSAPP_API_KEY=your_local_api_key
PORT=3001

# Vite frontend settings (optional if your frontend and backend run separately)
VITE_WHATSAPP_API_URL=http://localhost:3001
VITE_WHATSAPP_API_KEY=your_local_api_key
