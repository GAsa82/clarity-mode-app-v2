# WhatsApp Cloud API server settings
WHATSAPP_PHONE_ID=your_whatsapp_phone_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_RECIPIENTS=+15551234567,+15557654321
WHATSAPP_API_KEY=your_local_api_key
PORT=3001

# Vite frontend settings (optional if your frontend and backend run separately)
VITE_WHATSAPP_API_URL=http://localhost:3001
VITE_WHATSAPP_API_KEY=your_local_api_key

# Supabase — the frontend needs the public pair; the API functions ALSO need
# the service_role key (Supabase Dashboard → Settings → API → service_role).
# WITHOUT a real service key, every payment endpoint refuses to charge
# (orders/subscriptions can't be recorded). Check live state anytime:
#   curl -X POST https://<domain>/api/razorpay/purchase \
#     -H "Content-Type: application/json" -d '{"action":"health"}'
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_server_side_only

# Payments
# Razorpay (INR) is the default, verified-working gateway — no flag needed.
# Stripe/USD is HIDDEN unless you set the flag below to exactly "true".
# Only enable Stripe AFTER registering the webhook endpoint
# (https://<your-domain>/api/stripe/webhook) and adding STRIPE_WEBHOOK_SECRET to
# Vercel production — otherwise USD customers pay but the subscription never
# activates.
VITE_ENABLE_STRIPE=false

# Cross-project federation (Command Center → "Connected Businesses")
# Lets the admin console read Breakthrough Protocol's live metrics, which live
# in a SEPARATE Supabase project. Until BOTH are set, BP shows as "Not
# connected" (never an error). Server-side only — never expose the service key.
# BP_SUPABASE_URL=https://llflerfeiwhicrmunqzw.supabase.co
# BP_SUPABASE_SERVICE_ROLE_KEY=your_breakthrough_protocol_service_role_key
