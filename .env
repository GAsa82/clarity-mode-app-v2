# ═══════════════════════════════════════════════════════════════════════════════
# Clarity Mode — Frontend Environment Variables (Vite)
# ═══════════════════════════════════════════════════════════════════════════════
# For local development, copy this file as .env.local.
# For production (Vercel), set these in the Vercel project settings.
#
# VITE_ prefix is REQUIRED for Vite to expose these to client-side code.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── API Backend URL ──────────────────────────────────────────────────────────
# COMMENTED OUT: Using Vite proxy for local dev (/api → http://localhost:8000)
# and Vercel rewrites for production (/api → Railway backend).
# NO hardcoded URLs needed — CORS is handled by the proxy/rewrite layer.
# VITE_API_URL=http://localhost:8000

# ─── Supabase (Required for auth + database) ──────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://vajenjgxaznftlvribzl.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZhamVuamd4YXpuZnRsdnJpYnpsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA1ODQxNTQsImV4cCI6MjA5NjE2MDE1NH0.k82-y_2ZZPOjS4tJ-2fbXycG4g-MkzHjTuRYoTf_8xg

